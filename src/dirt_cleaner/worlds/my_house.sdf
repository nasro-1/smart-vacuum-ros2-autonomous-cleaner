<?xml version="1.0"?>
<sdf version="1.8">
<world name="my_house">

  <physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>

  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-ros2-system" name="gz::sim::systems::ROS2"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.9 0.85 0.75 1</diffuse>
    <specular>0.3 0.3 0.3 1</specular>
    <direction>-0.5 0.3 -0.8</direction>
  </light>

  <light name="ambient_light" type="point">
    <pose>0 0 2.8 0 0 0</pose>
    <diffuse>1 0.95 0.8 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <attenuation>
      <range>20</range><linear>0.05</linear>
      <constant>0.3</constant><quadratic>0.01</quadratic>
    </attenuation>
  </light>

  <!-- FLOOR -->
  <model name="floor">
    <static>true</static>
    <link name="floor_link">
      <collision name="floor_col">
        <geometry><box><size>12 10 0.05</size></box></geometry>
      </collision>
      <visual name="floor_vis">
        <geometry><box><size>12 10 0.05</size></box></geometry>
        <material>
          <ambient>0.76 0.60 0.42 1</ambient>
          <diffuse>0.76 0.60 0.42 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- WATER ZONE (blue) -->
  <model name="water_zone">
    <static>true</static>
    <pose>0.9 0.0 0.031 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>2.2 1.8 0.02</size></box></geometry>
        <material>
          <ambient>0.05 0.55 1.0 1</ambient>
          <diffuse>0.05 0.55 1.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- DIRT ZONE (yellow) -->
  <model name="dirt_zone">
    <static>true</static>
    <pose>0.3 0.9 0.031 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.7 0.7 0.012</size></box></geometry>
        <material>
          <ambient>0.9 0.8 0.0 1</ambient>
          <diffuse>0.9 0.8 0.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="dirt_zone_2">
    <static>true</static>
    <pose>-0.4 0.8 0.031 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.55 0.55 0.012</size></box></geometry>
        <material>
          <ambient>0.95 0.85 0.05 1</ambient>
          <diffuse>0.95 0.85 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="dirt_zone_3">
    <static>true</static>
    <pose>0.0 -0.9 0.031 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.6 0.5 0.012</size></box></geometry>
        <material>
          <ambient>0.92 0.82 0.03 1</ambient>
          <diffuse>0.92 0.82 0.03 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- CARPET ZONE (brown) -->
  <model name="carpet_zone">
    <static>true</static>
    <pose>-1.4 0.8 0.031 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>2.2 1.8 0.001</size></box></geometry>
        <material>
          <ambient>0.62 0.32 0.10 1</ambient>
          <diffuse>0.62 0.32 0.10 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- OUTER WALLS -->
  <model name="wall_south">
    <static>true</static><pose>0 -5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>12 0.2 3</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>12 0.2 3</size></box></geometry>
        <material><ambient>0.95 0.93 0.88 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="wall_north">
    <static>true</static><pose>0 5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>12 0.2 3</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>12 0.2 3</size></box></geometry>
        <material><ambient>0.95 0.93 0.88 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="wall_west">
    <static>true</static><pose>-6 0 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 10 3</size></box></geometry></collision>
