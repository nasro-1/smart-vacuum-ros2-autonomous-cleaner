      </visual>
    </link>
  </model>

  <model name="wall_east">
    <static>true</static><pose>6 0 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 10 3</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.2 10 3</size></box></geometry>
        <material><ambient>0.95 0.93 0.88 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- INTERIOR WALLS -->
  <model name="wall_div1_left">
    <static>true</static><pose>1 1.5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.2 4 3</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.2 4 3</size></box></geometry>
        <material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material>
