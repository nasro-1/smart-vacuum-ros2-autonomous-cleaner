        <material><ambient>0.92 0.90 0.85 1</ambient><diffuse>0.92 0.90 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- FURNITURE - all have floor-to-top collision boxes so lidar detects them -->

  <!-- Sofa: visual stays same, collision goes from floor up -->
  <model name="sofa_base">
    <static>true</static><pose>-3.5 -2 0.3 0 0 0</pose>
    <link name="link">
      <!-- Full height blocker from floor -->
      <collision name="col">
        <pose>0 0 -0.3 0 0 0</pose>
        <geometry><box><size>2 0.9 0.7</size></box></geometry>
      </collision>
      <visual name="vis"><geometry><box><size>2 0.9 0.4</size></box></geometry>
        <material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.3 0.4 0.65 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="sofa_back">
    <static>true</static><pose>-3.5 -2.4 0.7 0 0 0</pose>
